import java.util.*;

class Codechef {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while(t-- > 0) {

            String n = sc.next();

            char arr[] = n.toCharArray();

            int i = arr.length - 1;

            while(i >= 0 && arr[i] == '9') {
                arr[i] = '0';
                i--;
            }

            if(i >= 0) {
                arr[i] = (char)(arr[i] + 1);
                System.out.println(new String(arr));
            }
            else {
                System.out.println("1" + new String(arr));
            }
        }
    }
}
