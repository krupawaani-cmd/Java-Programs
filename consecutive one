Output Format
Print a single integer — the maximum number of consecutive 1s in the array.
Sample 1:
Input
Output
5
0 1 1 0 1
2

  public static int findMaxConsecutiveOnes(int[] nums) {
    int count = 0;
    int max = 0;

    for (int i = 0; i < nums.length; i++) {
        if (nums[i] == 1) {
            count++;
        } else {
            count = 0;
        }

        if (count > max) {
            max = count;
        }
    }

    return max;
}
