import java.util.*;

public class Main {

    public static void main(String[] args){

        Scanner sc = new Scanner(System.in);

        String str = sc.nextLine();

        HashSet<Character> set = new HashSet<>();

        for(int i = 0; i < str.length(); i++){

            char ch = str.charAt(i);

            if(!set.contains(ch)){

                System.out.print(ch);

                set.add(ch);

            }
        }
    }
}
